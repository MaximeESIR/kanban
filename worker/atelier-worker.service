[Unit]
Description=Atelier local assistant (outbound only)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/Documents/kanban
EnvironmentFile=%h/.config/atelier/worker.env
ExecStart=%h/Documents/kanban/worker/.venv/bin/python %h/Documents/kanban/worker/atelier_worker.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
# Reference only: connect_pc.sh generates the system unit for this PC.
# The receiver opens explicitly requested paths with the user's permissions.
# Codex commands have their own sandbox restricted to the selected directory.
ProtectSystem=full
ProtectHome=false
ReadOnlyPaths=%h/.config/atelier %h/Documents/kanban/worker %h/Documents/kanban/.codex
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
[Install]
WantedBy=default.target
