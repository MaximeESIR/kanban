[Unit]
Description=Atelier local assistant (outbound only)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/Documents/kanban
EnvironmentFile=%h/.config/atelier/worker.env
ExecStart=%h/Documents/kanban/worker/.venv/bin/python %h/Documents/kanban/worker/atelier_worker.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/atelier/executions %h/.codex
# Add one ReadWritePaths=/absolute/authorized/repo/.git per registered Git repository.
# Git worktree metadata requires this; Codex commands retain their own stricter profile.
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
[Install]
WantedBy=default.target
